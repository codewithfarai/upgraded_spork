version: '3.8'

services:
  applinks:
    image: {{ applinks_caddy_image }}
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    # Caddy needs net-bind to listen on :80 inside the container.
    cap_add:
      - NET_BIND_SERVICE
    read_only: true
    tmpfs:
      - /tmp
      # Caddy writes a small data dir (config snapshot, certs we don't use).
      - /data
      - /config
    networks:
      - traefik-public
    configs:
      - source: applinks_caddyfile-{{ applinks_caddyfile_hash }}
        target: /etc/caddy/Caddyfile
        mode: 0644
      - source: applinks_assetlinks-{{ applinks_assetlinks_hash }}
        target: /srv/.well-known/assetlinks.json
        mode: 0644
      - source: applinks_aasa-{{ applinks_aasa_hash }}
        # No .json extension — Apple is strict about this.
        target: /srv/.well-known/apple-app-site-association
        mode: 0644
      - source: applinks_index-{{ applinks_index_hash }}
        target: /srv/index.html
        mode: 0644
    deploy:
      mode: replicated
      replicas: {{ applinks_replicas | default(1) }}
      placement:
        constraints:
          - node.labels.role == worker
        preferences:
          - spread: node.id
      labels:
        - traefik.enable=true
        - traefik.http.routers.applinks.rule=Host(`{{ applinks_full_domain }}`)
        - traefik.http.routers.applinks.entrypoints=web
        - traefik.http.routers.applinks.service=applinks
        - traefik.http.routers.applinks.middlewares=security-headers@file,global-ratelimit@file
        - traefik.http.services.applinks.loadbalancer.server.port=80
        - traefik.swarm.network=traefik-public
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        order: start-first
      rollback_config:
        parallelism: 1
      resources:
        limits:
          cpus: '0.25'
          memory: 64M
        reservations:
          cpus: '0.05'
          memory: 16M

networks:
  traefik-public:
    external: true

configs:
  applinks_caddyfile-{{ applinks_caddyfile_hash }}:
    file: /opt/docker/stacks/applinks/files/Caddyfile
  applinks_assetlinks-{{ applinks_assetlinks_hash }}:
    file: /opt/docker/stacks/applinks/files/assetlinks.json
  applinks_aasa-{{ applinks_aasa_hash }}:
    file: /opt/docker/stacks/applinks/files/apple-app-site-association
  applinks_index-{{ applinks_index_hash }}:
    file: /opt/docker/stacks/applinks/files/index.html
