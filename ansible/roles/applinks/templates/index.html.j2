<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Open RideBase</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      text-align: center;
      padding: 64px 24px;
      color: #191C1D;
      background: #F8FAFA;
      margin: 0;
      min-height: 100vh;
      box-sizing: border-box;
    }
    .card {
      max-width: 360px;
      margin: 0 auto;
      background: #fff;
      border-radius: 16px;
      padding: 32px 24px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    }
    .logo {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: #004444;
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 700;
      font-size: 28px;
    }
    h1 {
      color: #004444;
      font-size: 20px;
      margin: 0 0 8px;
    }
    p {
      color: #6B7280;
      margin: 0;
      font-size: 14px;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">R</div>
    <h1>Open RideBase to continue</h1>
    <p>If the app didn't open automatically, return to the RideBase app and try again.</p>
  </div>
</body>
</html>
